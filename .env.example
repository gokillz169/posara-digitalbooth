# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Midtrans server-only credentials. Never expose MIDTRANS_SERVER_KEY to browser.
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_MERCHANT_ID="your-merchant-id"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Midtrans Payment Notification URL: https://your-domain/api/midtrans/notification

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# POSARA_QRIS_STATIC: Optional override for POSARA's built-in static EMVCo QRIS payload.
# POSARA already includes the verified official POSARA DIGITAL BOOTH (DEPOK) merchant QRIS
# by default; uncomment and set this only if rotating to a different merchant QRIS later.
# POSARA_QRIS_STATIC=""

# Supabase Storage & Database
SUPABASE_PROJECT_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# POSARA Admin / Owner Email (Optional override, defaults to mutawakkils16@gmail.com)
# POSARA_OWNER_EMAIL="mutawakkils16@gmail.com"

